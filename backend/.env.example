# ==============================================================================
# HotelFinder Backend Environment Configuration
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ── Server Configuration ───────────────────────────────────────────────────────
# Port number on which the Express REST API server will listen
PORT=3001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# ── Temporal Orchestration Engine ─────────────────────────────────────────────
# Host and port of the Temporal cluster frontend service
# Default local Temporal CLI server runs on 127.0.0.1:7233
TEMPORAL_ADDRESS=127.0.0.1:7233

# Temporal namespace used for scheduling and running search workflows
TEMPORAL_NAMESPACE=default

# Optional Temporal Cloud API Key (leave empty for local dev server)
# TEMPORAL_API_KEY=your_temporal_cloud_api_key_here

# ── CORS & Client Security ─────────────────────────────────────────────────────
# Primary frontend web app URL (used for CORS headers and verified redirects)
FRONTEND_URL=http://localhost:3000

# Optional additional allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Supplier Endpoints (Optional Overrides) ────────────────────────────────────
# By default, mock suppliers are integrated internally.
# Override these URLs if routing to external supplier microservices:
# SUPPLIER_A_URL=http://localhost:3001/api/v1/suppliers/a
# SUPPLIER_B_URL=http://localhost:3001/api/v1/suppliers/b
