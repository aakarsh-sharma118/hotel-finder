# ==============================================================================
# HotelFinder Frontend Environment Configuration
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ── GitHub Pages Base Path ────────────────────────────────────────────────────
# Set this to your repository name when deploying to GitHub Pages.
# Example: if your repo is github.com/aakarsh-sharma118/hotel-finder
# then set: VITE_REPO_BASE=hotel-finder
#
# Leave blank (or comment out) when running locally (e.g. http://localhost:3000/) or on custom domain.
VITE_REPO_BASE=hotel-finder

# ── Backend REST API Base URL ─────────────────────────────────────────────────
# Base URL for the backend REST API engine.
# Dynamically consumed by both Axios (hotelApi) and Vite's dev server proxy.
# Defaults to http://localhost:3001 for local development.
VITE_API_BASE_URL=http://localhost:3001
